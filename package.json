{
  "name": "ddklab",
  "version": "1.1.1",
  "description": "DDKLab — local-only Diadochokinetic analysis application",
  "main": "electron/main.cjs",
  "private": true,
  "author": "DDKLab",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node tests/ddk-detector.test.cjs",
    "test:syntax": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check dsp-v5.js && node --check src/ddk/app.js",
    "check": "npm run test && npm run test:syntax",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.ddklab.app",
    "productName": "DDKLab",
    "asar": true,
    "files": [
      "electron/**/*",
      "src/**/*",
      "README.md",
      "VALIDATION_STATUS.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DDKLab-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "releaseChannel": "stable"
}
